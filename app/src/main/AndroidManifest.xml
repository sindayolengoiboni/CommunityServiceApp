<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.usiu.communityservice">

    <!-- ================================================================
         PERMISSIONS
         ================================================================ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ================================================================
         APPLICATION
         ================================================================ -->
    <application
        android:name=".CommunityServiceApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CommunityService"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- ============================================================
             AUTH ACTIVITIES
             ============================================================ -->

        <!-- LAUNCHER: routes to the correct dashboard based on saved role -->
        <activity
            android:name=".ui.auth.SplashRouterActivity"
            android:exported="true"
            android:theme="@style/Theme.CommunityService.SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ============================================================
             STUDENT MODULE
             ============================================================ -->

        <activity
            android:name=".ui.student.StudentMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.OpportunityDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.student.SiteRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.student.AddDiaryEntryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.student.UploadReportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ============================================================
             SUPERVISOR MODULE
             ============================================================ -->

        <activity
            android:name=".ui.supervisor.SupervisorMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.supervisor.ReportIssueActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ============================================================
             COORDINATOR MODULE
             ============================================================ -->

        <activity
            android:name=".ui.coordinator.CoordinatorMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.coordinator.AddEditOrganizationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.coordinator.RecordSupervisionVisitActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.coordinator.AuditLogViewerActivity"
            android:exported="false" />

        <!-- ============================================================
             LECTURER MODULE
             ============================================================ -->

        <activity
            android:name=".ui.lecturer.LecturerMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.lecturer.GradeFeedbackActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ============================================================
             ADMIN MODULE
             ============================================================ -->

        <activity
            android:name=".ui.admin.AdminMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.EditUserRoleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ============================================================
             FILEPROVIDER — for sharing files via camera/gallery intents
             ============================================================ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
