<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Row 1: Student name + Status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_report_student"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="John Doe" />

            <TextView
                android:id="@+id/tv_report_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_badge"
                tools:text="Pending" />

        </LinearLayout>

        <!-- Report Type -->
        <TextView
            android:id="@+id/tv_report_type_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"
            tools:text="Mid-Semester Report" />

        <!-- Submitted Date -->
        <TextView
            android:id="@+id/tv_report_date_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"
            tools:text="Submitted: 12 Sep 2026" />

        <!-- Grade (shown if graded) -->
        <TextView
            android:id="@+id/tv_report_grade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/usiu_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Grade: 85 / 100"
            tools:visibility="visible" />

        <!-- Review Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_review_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_review"
            android:textAllCaps="false"
            android:textSize="13sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
