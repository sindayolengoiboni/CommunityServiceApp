<?xml version="1.0" encoding="utf-8"?>
<!--
    Data Extraction Rules (Android 12+)
    Disables cloud backup and device-to-device transfer for all app data.
    This prevents sensitive student/staff data from being exported via
    Android Backup or ADB backup without user awareness.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
