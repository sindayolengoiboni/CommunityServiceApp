rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role && getUserData().active == true;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return hasRole('ADMIN');
    }
    function isCoordinator() {
      return hasRole('COORDINATOR') || isAdmin();
    }
    function isLecturer() {
      return hasRole('LECTURER') || isAdmin();
    }
    function isSupervisor() {
      return hasRole('SUPERVISOR') || isAdmin();
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Public registration allowed only as STUDENT
      allow create: if isAuthenticated() && isOwner(userId) 
                    && request.resource.data.role == 'STUDENT'
                    && request.resource.data.active == true;
      allow read: if isOwner(userId) || isCoordinator() || isLecturer();
      allow update: if isAdmin() || (isOwner(userId) 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'eligibilityStatus', 'verifiedHours']));
      allow delete: if isAdmin();
    }

    // ORGANIZATIONS COLLECTION
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create, delete: if isCoordinator();
      allow update: if isCoordinator() || (isSupervisor() && getUserData().organizationId == orgId);
    }

    // OPPORTUNITIES COLLECTION
    match /opportunities/{oppId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isCoordinator() || isSupervisor();
    }

    // APPLICATIONS COLLECTION
    match /applications/{appId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentUid) || isSupervisor() || isCoordinator());
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isCoordinator() 
                    || (isSupervisor() && getUserData().organizationId == resource.data.organizationId)
                    || (isOwner(resource.data.studentUid) && request.resource.data.status == 'CANCELLED');
    }

    // REGISTRATIONS COLLECTION
    match /registrations/{regId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentUid) || isCoordinator() || isLecturer());
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isCoordinator();
    }

    // DIARY ENTRIES
    match /diaryEntries/{entryId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentUid) || isSupervisor() || isCoordinator() || isLecturer());
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid
                    && request.resource.data.verificationStatus == 'PENDING';
      allow update: if isCoordinator() 
                    || (isSupervisor() && getUserData().organizationId == resource.data.organizationId)
                    || (isOwner(resource.data.studentUid) && resource.data.verificationStatus == 'PENDING'
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'verifiedBy', 'verifiedAt']));
    }

    // ATTENDANCE COLLECTION
    match /attendance/{attId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentUid) || isSupervisor() || isCoordinator() || isLecturer());
      allow create: if isAuthenticated();
      allow update: if isSupervisor() || isCoordinator();
    }

    // SUPERVISION VISITS (Read-only for students, writeable only by Coordinator)
    match /supervisionVisits/{visitId} {
      allow read: if isAuthenticated() && (isCoordinator() || isLecturer() || resource.data.observedStudentUids.hasAny([request.auth.uid]));
      allow create, update, delete: if isCoordinator();
    }

    // ACADEMIC REPORTS
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentUid) || isLecturer() || isCoordinator());
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isLecturer() || isCoordinator()
                    || (isOwner(resource.data.studentUid) && resource.data.status in ['DRAFT', 'CORRECTION_REQUIRED']
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'gradeOrDecision', 'lecturerFeedback']));
    }

    // AUDIT LOGS (Append-only by authenticated users, readable by Admin and Coordinator)
    match /auditLogs/{logId} {
      allow read: if isCoordinator() || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // COURSE SETTINGS
    match /courseSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isCoordinator() || isAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow create: if isAuthenticated();
    }
  }
}
